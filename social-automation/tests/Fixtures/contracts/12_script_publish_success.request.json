{
  "provisional": false,
  "method": "POST",
  "path": "/api/v1/services/{service}/social-automation/packages/publish",
  "scope": "social-automation:package:publish",
  "body": {
    "package_key": "facebook.group.post.script",
    "kind": "script",
    "name": "Facebook Group Post Script",
    "version": "1.0.0",
    "schema_version": 1,
    "description": "RPA Script release — immutable",
    "manifest": {
      "script_id": "facebook.group.post",
      "variables": [
        { "key": "text", "type": "text", "description": "Post body" },
        { "key": "group_url", "type": "text", "description": "Target group URL" }
      ],
      "outputs": [
        { "key": "post_url", "type": "text" }
      ],
      "steps": [
        { "id": "s1", "version": 1, "action": "CLICK_TARGET", "name": "Open composer" },
        { "id": "s2", "version": 1, "action": "CLICK_AND_TYPE", "name": "Type text", "variable_key": "text" }
      ],
      "runtime_requirements": { "runner_min": "2.0.0" },
      "assets": [
        { "path": "assets/roi-1.png", "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "kind": "roi" }
      ],
      "video_demo": {
        "artifact_ref": "evidence/case/run/recording.webm",
        "mime": "video/webm",
        "sha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        "test_run_id": "11111111-1111-1111-1111-111111111111",
        "script_version": "1.0.0",
        "reviewed": true,
        "audio": false,
        "desktop_capture": false
      }
    },
    "dependencies": [],
    "runtime_compatibility": { "runner_min": "2.0.0" }
  },
  "notes": [
    "Script is independent of widget/workflow kinds.",
    "Top-level manifest.script remains forbidden (executable).",
    "Video demo is optional on draft; official release may require it later."
  ]
}
