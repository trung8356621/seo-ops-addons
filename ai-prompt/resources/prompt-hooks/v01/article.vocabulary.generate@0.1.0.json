{
  "spec_version": "0.1",
  "key": "article.vocabulary.generate",
  "version": "0.1.0",
  "status": "experimental",
  "settings_visible": true,
  "category": "article_editor",
  "name": "Generate article vocabulary",
  "description": "Generate semantic vocabulary markdown only — single reasoning task, topic-driven.",
  "enabled": true,
  "classification": "NORMALIZE_NOW",

  "legacy_binding": "vocabulary_prompt_id | split outline step call 2",

  "model": {
    "provider": "prompt_connection",
    "name": "configured",
    "settings": {
      "temperature": 0.4
    }
  },

  "locale": {
    "mode": "site",
    "fallback": "en"
  },

  "input_schema": {
    "post_title": {
      "type": "string",
      "required": true,
      "nullable": false,
      "max_length": 500,
      "allowed_source": ["runtime", "task", "article"]
    },
    "outline": {
      "type": "string",
      "required": true,
      "nullable": false,
      "max_length": 50000,
      "allowed_source": ["runtime", "previous_outputs"]
    },
    "keyword": {
      "type": "string",
      "required": false,
      "nullable": true,
      "max_length": 500,
      "allowed_source": ["runtime", "task"]
    },
    "focus_keyword": {
      "type": "string",
      "required": false,
      "nullable": true,
      "max_length": 500,
      "allowed_source": ["runtime", "task"]
    },
    "topic": {
      "type": "string",
      "required": false,
      "nullable": true,
      "max_length": 500,
      "allowed_source": ["runtime", "task"]
    },
    "site_description": {
      "type": "string",
      "required": false,
      "nullable": true,
      "max_length": 8000,
      "allowed_source": ["site_context"]
    },
    "tone": {
      "type": "string",
      "required": false,
      "nullable": true,
      "max_length": 500,
      "allowed_source": ["seo_prompt_settings", "runtime"]
    },
    "language": {
      "type": "string",
      "required": false,
      "nullable": true,
      "max_length": 100,
      "allowed_source": ["site_context", "runtime"]
    }
  },

  "output_schema": {
    "type": "markdown_sections",
    "sections": [
      {
        "key": "vocabulary",
        "label": "Từ vựng",
        "task": 2,
        "content_type": "markdown",
        "start_marker": "[START_TASK_2_VOCABULARY]",
        "end_marker": "[END_TASK_2_VOCABULARY]",
        "required": true,
        "output_port": "task_2_vocabulary",
        "validation": {
          "not_empty": true,
          "min_length": 100,
          "reject_nested_task_markers": true
        },
        "normalize": ["trim", "strip_markdown_fence"]
      }
    ],
    "combined_output": {
      "enabled": false
    },
    "validation": {
      "reject_unknown_task_markers": true,
      "reject_duplicate_sections": true,
      "require_declared_order": true,
      "allow_text_outside_sections": false
    }
  },

  "template": {
    "source": "legacy_prompt_content",
    "system": null,
    "user": null
  },

  "presentation": {
    "description": "Generate semantic vocabulary from article title + outline — not outline summarization.",
    "default_instructions": [],
    "output_format": [
      "Vocabulary only — wrapped in [START_TASK_2_VOCABULARY] / [END_TASK_2_VOCABULARY]."
    ],
    "variables": [
      { "key": "post_title", "required": true },
      { "key": "outline", "required": true },
      { "key": "keyword", "required": false },
      { "key": "focus_keyword", "required": false },
      { "key": "topic", "required": false },
      { "key": "site_description", "required": false },
      { "key": "tone", "required": false },
      { "key": "language", "required": false }
    ]
  },

  "validation": {
    "not_empty": true
  },

  "retry": {
    "max": 1,
    "on": ["empty", "provider_timeout"]
  },

  "logging": {
    "store_full_prompt": false,
    "store_full_output": false,
    "redact_sensitive": true
  },

  "permissions": {
    "capability": "text"
  },

  "metadata": {
    "prompt_concern": "semantic vocabulary only",
    "workflow_concern": "split outline step — call 2",
    "required_inputs": ["post_title", "outline"]
  },

  "side_effects": []
}
