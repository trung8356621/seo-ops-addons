{
  "spec_version": "0.1",
  "key": "article.vocabulary.generate",
  "version": "0.1.0",
  "status": "experimental",
  "settings_visible": true,
  "category": "article_editor",
  "name": "Generate article vocabulary",
  "description": "Generate semantic vocabulary markdown only — single reasoning task, topic-driven.",
  "enabled": true,
  "classification": "NORMALIZE_NOW",

  "legacy_binding": "vocabulary_prompt_id | split outline step call 2",

  "model": {
    "provider": "prompt_connection",
    "name": "configured",
    "settings": {
      "temperature": 0.4
    }
  },

  "locale": {
    "mode": "site",
    "fallback": "en"
  },

  "input_schema": {
    "input": {
      "type": "string",
      "required": false,
      "nullable": true,
      "max_length": 8000,
      "allowed_source": ["runtime", "task"],
      "label": "Canonical task subject ({{input}})"
    },
    "post_title": {
      "type": "string",
      "required": true,
      "nullable": false,
      "max_length": 500,
      "allowed_source": ["runtime", "task", "article"]
    },
    "outline": {
      "type": "string",
      "required": true,
      "nullable": false,
      "max_length": 50000,
      "allowed_source": ["runtime", "previous_outputs"]
    },
    "keyword": {
      "type": "string",
      "required": false,
      "nullable": true,
      "max_length": 500,
      "allowed_source": ["runtime", "task"]
    },
    "focus_keyword": {
      "type": "string",
      "required": false,
      "nullable": true,
      "max_length": 500,
      "allowed_source": ["runtime", "task"]
    },
    "topic": {
      "type": "string",
      "required": false,
      "nullable": true,
      "max_length": 500,
      "allowed_source": ["runtime", "task"]
    },
    "site_description": {
      "type": "string",
      "required": false,
      "nullable": true,
      "max_length": 8000,
      "allowed_source": ["site_context"]
    },
    "tone": {
      "type": "string",
      "required": false,
      "nullable": true,
      "max_length": 500,
      "allowed_source": ["seo_prompt_settings", "runtime"]
    },
    "language": {
      "type": "string",
      "required": false,
      "nullable": true,
      "max_length": 100,
      "allowed_source": ["site_context", "runtime"]
    }
  },

  "output_schema": {
    "type": "markdown",
    "normalize": ["trim", "strip_markdown_fence"],
    "validation": {
      "not_empty": true,
      "min_length": 100
    }
  },

  "template": {
    "source": "legacy_prompt_content",
    "system": null,
    "user": null
  },

  "presentation": {
    "description": "Generate semantic vocabulary from article title + outline — not outline summarization.",
    "default_instructions": [],
    "output_format": [
      "Vocabulary markdown only — direct output, no START/END task markers."
    ],
    "variables": [
      { "key": "input", "required": false },
      { "key": "post_title", "required": true },
      { "key": "outline", "required": true },
      { "key": "keyword", "required": false },
      { "key": "focus_keyword", "required": false },
      { "key": "topic", "required": false },
      { "key": "site_description", "required": false },
      { "key": "tone", "required": false },
      { "key": "language", "required": false }
    ]
  },

  "validation": {
    "not_empty": true
  },

  "retry": {
    "max": 1,
    "on": ["empty", "provider_timeout"]
  },

  "logging": {
    "store_full_prompt": false,
    "store_full_output": false,
    "redact_sensitive": true
  },

  "permissions": {
    "capability": "text"
  },

  "metadata": {
    "prompt_concern": "semantic vocabulary only",
    "workflow_concern": "split outline step — call 2",
    "required_inputs": ["post_title", "outline"]
  },

  "side_effects": []
}
