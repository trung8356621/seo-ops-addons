{
  "id": "seo-ops-local-env",
  "name": "SEO-OPS Local Environment Template",
  "values": [
    {
      "key": "base_url",
      "value": "http://seo-ops.test",
      "type": "default",
      "enabled": true
    },
    {
      "key": "site_id",
      "value": "4",
      "type": "default",
      "enabled": true
    },
    {
      "key": "site_ref",
      "value": "site-4",
