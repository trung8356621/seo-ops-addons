    {
      "key": "cookie_laravel_session",
      "value": "{{REPLACE_WITH_YOUR_LARAVEL_SESSION_COOKIE}}",
      "type": "secret",
      "enabled": true
    },
    {
      "key": "csrf_token",
      "value": "{{REPLACE_WITH_YOUR_CSRF_TOKEN}}",
      "type": "secret",
      "enabled": true
    },
    {
      "key": "thread_ulid",
      "value": "",
      "type": "default",
      "enabled": true
    },
    {
      "key": "paused_run_ulid",
      "value": "",
      "type": "default",
      "enabled": true
    }
  ],
  "_postman_variable_scope": "environment"
}
