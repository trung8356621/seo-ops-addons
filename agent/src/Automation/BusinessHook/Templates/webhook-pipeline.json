{
  "schema_version": 3,
  "template": "webhook-pipeline",
  "rule": {
    "code": "webhook-pipeline",
    "name": "Webhook pipeline",
    "description": "Send webhook on article completed. DISABLED by default.",
    "event_name": "article.completed",
    "is_enabled": false,
    "priority": 110,
    "stop_on_failure": true,
    "run_mode": "queued",
    "workflow_mode": "graph",
    "trigger_type": "event",
    "nodes": [
      { "node_key": "trigger", "node_type": "trigger", "name": "Trigger", "position": 0, "is_enabled": true },
      { "node_key": "webhook", "node_type": "action", "name": "Send webhook", "action_code": "webhook.send", "position": 1, "is_enabled": true, "settings": { "url": "https://example.com/hooks/automation" } },
      { "node_key": "notify_fail", "node_type": "action", "name": "Notify failure", "action_code": "notification.send", "position": 2, "is_enabled": true, "input_mapping": { "message": "Webhook failed for article {{ payload.article_id }}" } },
      { "node_key": "end_ok", "node_type": "end", "name": "End OK", "position": 3, "is_enabled": true },
      { "node_key": "end_fail", "node_type": "end", "name": "End fail", "position": 4, "is_enabled": true }
    ],
    "edges": [
      { "from_node_key": "trigger", "to_node_key": "webhook", "branch": "always", "priority": 100 },
      { "from_node_key": "webhook", "to_node_key": "end_ok", "branch": "success", "priority": 100 },
      { "from_node_key": "webhook", "to_node_key": "notify_fail", "branch": "failure", "priority": 100 },
      { "from_node_key": "notify_fail", "to_node_key": "end_fail", "branch": "always", "priority": 100 }
    ]
  }
}
